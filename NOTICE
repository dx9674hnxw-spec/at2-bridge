The following files in this repository are direct ports of logic from
that project:

  app/protocol/frame.py       <- At2FrameCodec.kt, Crc16CcittFalse.kt
  app/protocol/channel.py     <- At2ChannelCodec.kt, At2Commands.kt (channel parts)
  app/protocol/commands.py    <- At2Commands.kt (device/query commands)
  app/protocol/messages.py    <- At2OfflineMessageCodec.kt (text messages only)
  app/transport/ble_transport.py <- BleConstants.kt (GATT service/characteristic UUIDs)

